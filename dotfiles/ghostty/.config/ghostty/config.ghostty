# 背景透明度（0.0 到 1.0，越小越透明，建议 0.85 左右效果最好）
background-opacity = 0.6

# 背景模糊半径（数值越大越模糊，通常 15-20 比较合适）
#background-blur-radius = 20
theme = noctalia

# Preserve Ghostty's embedded default font and override only CJK glyphs.
font-codepoint-map = U+2E80-U+2FFF,U+3000-U+303F,U+31C0-U+31EF,U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF,U+FE30-U+FE4F,U+FF00-U+FFEF,U+20000-U+323AF=Noto Sans Mono CJK SC

custom-shader = "~/.config/ghostty/shaders/cursor_smear.glsl"

# window-decoration = none
